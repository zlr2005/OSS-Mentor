# Never commit a real token. Public pilot collection should use one team-managed,
# read-only credential supplied only at runtime.
GITHUB_TOKEN=

# GitHub OAuth app credentials for login. Leave empty to run in local demo mode:
# serve-api then answers /api/v1/auth/github/start with oauth_configured=false
# instead of failing, and the anonymous/preset pages keep working.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Required when OAuth is configured. Used to sign the one-time OAuth state and to
# derive the stored credential reference; a short random value is enough, but never
# reuse a value that is committed anywhere.
OSS_MENTOR_SESSION_SECRET=

# Absolute base URL of this deployment; login redirects and Secure cookies depend on
# it. Defaults to http://<host>:<port> of the running server.
OSS_MENTOR_BASE_URL=http://127.0.0.1:8765

OSS_MENTOR_GITHUB_API_BASE=https://api.github.com
OSS_MENTOR_GITHUB_API_VERSION=2026-03-10
OSS_MENTOR_ECOSYSTEMS_ISSUES_API_BASE=https://issues.ecosyste.ms/api/v1
OSS_MENTOR_USER_AGENT=OSS-Mentor-research/0.1.0
OSS_MENTOR_REPO_CONFIG=config/pilot_repositories_v0.1.csv
OSS_MENTOR_RAW_DIR=data/raw
OSS_MENTOR_HTTP_TIMEOUT_SECONDS=30
OSS_MENTOR_MAX_RETRIES=5
OSS_MENTOR_BACKOFF_BASE_SECONDS=1

# Read as serve-api defaults for --host/--port. compose.yaml additionally passes the
# container binding explicitly, because a non-loopback bind needs --allow-remote.
OSS_MENTOR_HOST=127.0.0.1
OSS_MENTOR_PORT=8765

# Reserved for the PostgreSQL deployment path. The runtime is SQLite-only today:
# no adapter reads this value yet, so keep it out of local runs and treat
# PostgreSQL as migration-level support only.
OSS_MENTOR_DATABASE_URL=sqlite:///data/oss_mentor.sqlite3
